rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Gallery collection — visitors can submit anonymously,
    // anyone can read the latest entries.
    match /gallery/{docId} {
      // Allow anyone to read gallery entries
      allow read: if true;

      // Allow anyone to create (anonymous submissions)
      // but restrict the document fields to prevent abuse
      allow create: if request.resource.data.keys().hasAll(['name', 'answers', 'roomCount', 'timestamp'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 30
                    && request.resource.data.answers is map
                    && request.resource.data.roomCount is number
                    && request.resource.data.roomCount <= 10;

      // No updates or deletes from clients
      allow update, delete: if false;
    }

    // Meta collection for aggregate stats (admin-only writes)
    match /meta/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
